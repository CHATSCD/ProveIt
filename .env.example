# ============================================================
# ProveIt — environment variables
# ============================================================
# This file documents every env var actually referenced in code as of
# the last audit (2026-08-21, cross-checked via grep for
# `Deno.env.get(...)` in supabase/functions/*/index.ts and
# `import.meta.env.VITE_...` in src/). Two different kinds of vars are
# mixed together in a typical ProveIt deploy — keep them separate:
#
#   1. FRONTEND build-time vars (VITE_ prefix) — bundled into the client
#      JS by Vite at build time. These are PUBLIC. Anyone can read them
#      out of the shipped bundle, so only ever put values here that are
#      safe to expose (e.g. a Supabase anon key, which relies on RLS for
#      actual protection). Set these in Vercel's Project Settings ->
#      Environment Variables.
#
#   2. SUPABASE EDGE FUNCTION secrets (no VITE_ prefix) — server-side
#      only, used by code in supabase/functions/*/index.ts. Set these
#      with `supabase secrets set NAME=value`, NEVER by adding a VITE_
#      prefix or putting them in the Vercel frontend env. If a server
#      secret ever gets a VITE_ prefix by mistake, it will be bundled
#      into the public client JS — treat that as a leaked secret.
#
# NOTE (found during the 2026-08-21 production-readiness audit): the
# frontend does NOT currently read VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
# from import.meta.env at all — grepping src/ turns up zero
# `import.meta.env` references anywhere. src/lib/supabase.js hardcodes
# the Supabase URL and anon key directly instead. The anon key is safe
# to expose either way (RLS-protected), so this isn't a security bug,
# but it means these two VITE_ vars are currently unused by the app code
# even though they're listed here / presumably set in Vercel. Worth
# deciding deliberately whether to wire src/lib/supabase.js to read from
# import.meta.env (recommended — makes env swaps possible without a
# code change) or to drop these two vars from Vercel as dead config.

# --- Frontend (Vite build-time, public) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Supabase Edge Function secrets (server-side only) ---
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are
# auto-injected into every deployed edge function by the Supabase
# runtime — you do NOT need to run `supabase secrets set` for these
# three; they're listed here only so it's clear which functions rely on
# them (daily-digest, process-checks, send-push, create-checkout-session,
# stripe-webhook all use SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY;
# create-checkout-session also uses SUPABASE_ANON_KEY).
# SUPABASE_URL=(auto-provided by Supabase at runtime)
# SUPABASE_ANON_KEY=(auto-provided by Supabase at runtime)
# SUPABASE_SERVICE_ROLE_KEY=(auto-provided by Supabase at runtime)

# Required for supabase/functions/send-push to actually send pushes (the
# function returns an error and no-ops without it). Generate a VAPID
# keypair (e.g. `npx web-push generate-vapid-keys`) — the PUBLIC half is
# already hardcoded in src/lib/push.js and
# supabase/functions/send-push/index.ts (VAPID_PUBLIC_KEY, safe to expose);
# only the PRIVATE half belongs here.
#   supabase secrets set VAPID_PRIVATE_KEY=...
VAPID_PRIVATE_KEY=

# Optional — a mailto: or https: URL identifying who's sending the push,
# per the Web Push spec. Falls back to mailto:support@proveit.app in code
# if unset, so this only needs to be set to override that default.
#   supabase secrets set VAPID_SUBJECT=mailto:you@yourdomain.com
VAPID_SUBJECT=

# Required for supabase/functions/create-checkout-session and
# supabase/functions/stripe-webhook (Stripe billing). Both fall back to
# an empty string if unset rather than throwing at import time, but will
# fail at request time without a real key.
#   supabase secrets set STRIPE_SECRET_KEY=sk_live_...
#   supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
