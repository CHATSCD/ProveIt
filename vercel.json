{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/trigger-checks",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/trigger-digest",
      "schedule": "0 12 * * *"
    }
  ]
}
